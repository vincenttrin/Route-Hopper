# Copy to .env next to docker-compose.yml; Docker Compose reads it on its own.
# Never commit .env: it holds the Grafana Cloud token.

# Ship metrics to Grafana Cloud (starts the alloy service). Leave unset to run without it.
#COMPOSE_PROFILES=metrics

# Grafana Cloud > your stack > Prometheus > Details.
# Remote write endpoint, ending in /api/prom/push.
GRAFANA_CLOUD_PROM_URL=
# The numeric username shown next to it.
GRAFANA_CLOUD_PROM_USER=
# An access policy token with the metrics:write scope.
GRAFANA_CLOUD_API_KEY=
